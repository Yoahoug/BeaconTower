# 依赖与构建产物（dist 留 .placeholder 兜底 go:embed 编译期存在性检查）
node_modules/
web/dist/*
!web/dist/.placeholder
web-toy/dist/*
!web-toy/dist/.placeholder

# 运行时数据（SQLite、密钥）——绝不入库
data/
*.db
*.db-wal
*.db-shm
*.key

# 环境与密钥
.env
.env.*

# 编辑器与系统文件
.DS_Store
.idea/
.vscode/
*.log

# AI 协作工具的本地状态（会话/缓存，非项目内容）
.zcode/
.zcodeignore
.agents